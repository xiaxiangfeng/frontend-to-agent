{
  "name": "frontend-to-agent",
  "version": "0.0.0",
  "private": true,
  "description": "面向前端开发者的中文 Agent 工程实战教程与研究助手示例",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "chapter:check": "node scripts/check-chapter.mjs",
    "dev": "pnpm --parallel --filter @agent-book/api --filter @agent-book/web run dev",
    "dev:api": "pnpm --filter @agent-book/api dev",
    "dev:web": "pnpm --filter @agent-book/web dev",
    "docs:build": "vitepress build docs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "4.1.11"
  }
}
