# Server-only secrets. Keep values empty in committed files.
DASHSCOPE_API_KEY=
APP_ACCESS_TOKEN=

# Copy the OpenAI-compatible base URL for your Model Studio workspace.
DASHSCOPE_BASE_URL=

# Set a text model and an embedding model available in your workspace.
QWEN_MODEL=
QWEN_EMBEDDING_MODEL=

# Local development defaults.
DATABASE_URL=file:./data/research.sqlite
QDRANT_URL=http://127.0.0.1:6333
RUN_LIVE_TESTS=0
